<file path="extension/popup.html">
<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8"/>
<title>AutoPostula</title>
<style>
/* ── Reset & base ────────────────────────────────────────── */
*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

:root {
  --bg:       #F8F9FC;
  --surface:  #FFFFFF;
  --border:   #E4E7EF;
  /* Mismo violeta que usa el resto del producto (login/registro/onboarding
     y el color "IA respondiendo…" de content.js) — antes era azul (#2563EB),
     sin relación con la identidad de la marca. */
  --accent:   #7C3AED;
  --accent-h: #6D28D9;
  --accent-s: #F3EEFF;
  --danger:   #DC2626;
  --danger-s: #FEF2F2;
  --success:  #16A34A;
  --success-s:#F0FDF4;
  --warn:     #D97706;
  --text-1:   #111827;
  --text-2:   #4B5563;
  --text-3:   #9CA3AF;
  --radius:   8px;
  --shadow:   0 1px 3px rgba(0,0,0,.08), 0 1px 2px rgba(0,0,0,.06);
}

html { font-size: 13px; }
body {
  width: 400px;
  max-height: 600px;
  overflow-y: auto;
  overflow-x: hidden;
  background: var(--bg);
  color: var(--text-1);
  font-family: 'Inter', 'Segoe UI', system-ui, sans-serif;
  line-height: 1.5;
  scrollbar-width: thin;
  scrollbar-color: var(--border) transparent;
}
body::-webkit-scrollbar { width: 4px; }
body::-webkit-scrollbar-thumb { background: var(--border); border-radius: 2px; }

/* ── Header ──────────────────────────────────────────────── */
.header {
  background: var(--surface);
  border-bottom: 1px solid var(--border);
  padding: 14px 16px 12px;
  display: flex;
  align-items: center;
  gap: 12px;
  position: sticky;
  top: 0;
  z-index: 10;
}
.header-logo {
  width: 34px; height: 34px;
  background: var(--accent);
  color: #fff;
  border-radius: 9px;
  display: grid; place-items: center;
  font-size: 13px;
  font-weight: 700;
  letter-spacing: -.2px;
  flex-shrink: 0;
  box-shadow: 0 2px 8px rgba(124,58,237,.3);
}
.header-info { flex: 1; min-width: 0; }
.header-title {
  font-size: 14px;
  font-weight: 700;
  color: var(--text-1);
  letter-spacing: -.2px;
}
.header-sub { font-size: 11px; color: var(--text-3); }

/* Pulso de actividad — firma visual */
.pulse-wrap {
  display: flex; align-items: center; gap: 6px;
  flex-shrink: 0;
}
.pulse {
  width: 8px; height: 8px;
  border-radius: 50%;
  background: var(--text-3);
  transition: background .3s;
}
.pulse.active {
  background: var(--success);
  animation: pulse-ring 1.4s ease-out infinite;
}
.pulse.working { background: var(--warn); animation: pulse-ring 0.8s ease-out infinite; }
@keyframes pulse-ring {
  0%   { box-shadow: 0 0 0 0 currentColor; }
  70%  { box-shadow: 0 0 0 5px transparent; }
  100% { box-shadow: 0 0 0 0 transparent; }
}
.pulse.active  { box-shadow: 0 0 0 0 rgba(22,163,74,.4); }
.pulse.working { box-shadow: 0 0 0 0 rgba(217,119,6,.4); }
.pulse-label { font-size: 11px; font-weight: 600; color: var(--text-3); }
.pulse-label.active  { color: var(--success); }
.pulse-label.working { color: var(--warn); }

/* ── Toggle master ───────────────────────────────────────── */
.master-row {
  display: flex; align-items: center; justify-content: space-between;
  padding: 12px 16px;
  background: var(--surface);
  border-bottom: 1px solid var(--border);
}
.master-left .label { font-size: 13px; font-weight: 600; }
.master-left .hint  { font-size: 11px; color: var(--text-3); }
.toggle {
  position: relative; width: 42px; height: 23px; flex-shrink: 0;
}
.toggle input { display: none; }
.toggle-track {
  position: absolute; inset: 0;
  background: var(--border);
  border-radius: 12px;
  cursor: pointer;
  transition: background .2s;
}
.toggle-thumb {
  position: absolute;
  width: 17px; height: 17px;
  top: 3px; left: 3px;
  background: #fff;
  border-radius: 50%;
  transition: transform .2s;
  box-shadow: 0 1px 3px rgba(0,0,0,.2);
  pointer-events: none;
}
.toggle input:checked ~ .toggle-track { background: var(--accent); }
.toggle input:checked ~ .toggle-thumb { transform: translateX(19px); }

/* ── Stats strip ─────────────────────────────────────────── */
.stats {
  display: grid; grid-template-columns: repeat(3, 1fr);
  background: var(--surface);
  border-bottom: 1px solid var(--border);
}
.stat {
  padding: 10px 0;
  text-align: center;
  border-right: 1px solid var(--border);
}
.stat:last-child { border-right: none; }
.stat-n  { font-size: 18px; font-weight: 700; color: var(--text-1); line-height: 1; }
.stat-n.accent { color: var(--accent); }
.stat-n.success { color: var(--success); }
.stat-label { font-size: 10px; color: var(--text-3); margin-top: 2px; }

/* ── Secciones ───────────────────────────────────────────── */
.section {
  background: var(--surface);
  border-bottom: 1px solid var(--border);
  padding: 14px 16px;
}
.section-head {
  display: flex; align-items: center; justify-content: space-between;
  margin-bottom: 10px;
}
.section-title {
  font-size: 11px; font-weight: 700;
  color: var(--text-2);
  text-transform: uppercase;
  letter-spacing: .6px;
}
.section-action {
  font-size: 11px; color: var(--accent);
  cursor: pointer; font-weight: 500;
  background: none; border: none;
}
.section-action:hover { text-decoration: underline; }

/* ── Tags ────────────────────────────────────────────────── */
.tags { display: flex; flex-wrap: wrap; gap: 5px; margin-bottom: 8px; min-height: 10px; }
.tag {
  display: inline-flex; align-items: center; gap: 4px;
  padding: 3px 8px; border-radius: 20px;
  font-size: 11px; font-weight: 500;
  cursor: default;
}
.tag.inc, .tag.loc { background: var(--accent-s); color: var(--accent); border: 1px solid #DDD1FB; }
.tag.exc { background: var(--danger-s); color: var(--danger); border: 1px solid #FECACA; }
.tag-x {
  background: none; border: none; cursor: pointer;
  color: inherit; opacity: .5; font-size: 12px; padding: 0; line-height: 1;
}
.tag-x:hover { opacity: 1; }

.input-row { display: flex; gap: 6px; }
.field {
  flex: 1;
  border: 1px solid var(--border);
  border-radius: var(--radius);
  padding: 6px 10px;
  font-size: 12px;
  color: var(--text-1);
  background: var(--bg);
  outline: none;
  font-family: inherit;
  transition: border-color .15s;
}
.field:focus { border-color: var(--accent); background: #fff; }
.field::placeholder { color: var(--text-3); }
.field.danger:focus { border-color: var(--danger); }

.btn {
  padding: 6px 12px;
  border-radius: var(--radius);
  border: none;
  font-size: 12px; font-weight: 600;
  cursor: pointer;
  transition: background .15s, opacity .15s;
  white-space: nowrap;
}
.btn:disabled { opacity: .55; cursor: default; }
.btn-primary { background: var(--accent); color: #fff; }
.btn-primary:hover { background: var(--accent-h); }
.btn-ghost { background: var(--bg); color: var(--text-2); border: 1px solid var(--border); }
.btn-ghost:hover { border-color: var(--text-3); color: var(--text-1); }
.btn-danger-ghost { background: var(--danger-s); color: var(--danger); border: 1px solid #FECACA; }
.btn-danger-ghost:hover { background: #FEE2E2; }

/* ── Chips jornada ───────────────────────────────────────── */
.chips { display: flex; flex-wrap: wrap; gap: 6px; }
.chip {
  padding: 5px 11px;
  border-radius: 20px;
  font-size: 11px; font-weight: 500;
  border: 1px solid var(--border);
  background: var(--bg);
  color: var(--text-2);
  cursor: pointer;
  transition: all .15s;
  user-select: none;
}
.chip.selected { background: var(--accent-s); color: var(--accent); border-color: #DDD1FB; }

/* ── Información adicional ────────────────────────────────── */
.info-list { display: flex; flex-direction: column; gap: 6px; margin-bottom: 8px; }
.info-item {
  display: flex; align-items: flex-start; justify-content: space-between; gap: 8px;
  padding: 8px 10px;
  background: var(--bg);
  border: 1px solid var(--border);
  border-radius: var(--radius);
}
.info-item-text {
  font-size: 11px; color: var(--text-1);
  flex: 1; line-height: 1.4;
}
.info-empty {
  font-size: 11px; color: var(--text-3);
  padding: 4px 0; font-style: italic;
}

/* ── Estado con punto de color (perfil / cuenta web) ──────── */
.status-row { display: flex; gap: 6px; align-items: center; }
.status-input-wrap { flex: 1; position: relative; }
.status-input-wrap .field { width: 100%; padding-right: 36px; }
.status-eye {
  position: absolute; right: 8px; top: 50%; transform: translateY(-50%);
  background: none; border: none; cursor: pointer;
  font-size: 14px; color: var(--text-3); line-height: 1;
}
.status-eye:hover { color: var(--text-1); }
.status-line {
  font-size: 10px; margin-top: 4px;
  display: flex; align-items: center; gap: 4px;
}
.status-line .dot { width: 5px; height: 5px; border-radius: 50%; background: var(--text-3); flex-shrink: 0; }
.status-line .dot.ok  { background: var(--success); }
.status-line .dot.err { background: var(--danger); }

/* ── Tarjeta de perfil (solo lectura, viene de la web) ────── */
.perfil-card {
  background: var(--bg);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  padding: 10px 12px;
  font-size: 12px;
  color: var(--text-2);
  line-height: 1.6;
  margin-bottom: 8px;
}
.perfil-card b { color: var(--text-1); }
.perfil-card .vacio { color: var(--text-3); font-style: italic; }

/* ── Footer ───────────────────────────────────────────────── */
.footer {
  background: var(--surface);
  border-top: 1px solid var(--border);
  padding: 10px 16px;
  display: flex; gap: 8px;
  position: sticky; bottom: 0; z-index: 10;
}
.footer .btn-primary { flex: 1; font-size: 13px; padding: 8px; }

/* ── Toast ────────────────────────────────────────────────── */
.toast {
  position: fixed; bottom: 52px; left: 50%; transform: translateX(-50%) translateY(8px);
  background: var(--text-1); color: #fff;
  font-size: 11px; font-weight: 600;
  padding: 6px 14px; border-radius: 20px;
  opacity: 0; pointer-events: none;
  transition: opacity .25s, transform .25s;
  white-space: nowrap; z-index: 100;
}
.toast.show { opacity: 1; transform: translateX(-50%) translateY(0); }

/* ── Divider helper ──────────────────────────────────────── */
.spacer { height: 6px; background: var(--bg); }
.hidden { display: none !important; }
</style>
</head>
