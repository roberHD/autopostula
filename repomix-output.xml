.ap-shell {
  --bg: oklch(0.145 0.006 275);
  --bg-elevated: oklch(0.205 0.008 275);
  --bg-elevated-2: oklch(0.255 0.01 275);
  --border: oklch(1 0 0 / 10%);
  --text: oklch(0.96 0.005 275);
  --text-muted: oklch(0.66 0.02 275);
  --accent: oklch(0.65 0.19 280);
  --accent-contrast: oklch(0.99 0.005 280);
  --status-enviado: oklch(0.66 0.02 275);
  --status-visto: oklch(0.65 0.19 280);
  --status-en-proceso: oklch(0.75 0.14 85);
  --status-finalista: oklch(0.75 0.15 150);
  --status-finalizado: oklch(0.72 0.13 180);
  --status-rechazado: oklch(0.7 0.19 25);
  --chart-1: oklch(0.65 0.19 280);
  --chart-2: oklch(0.72 0.15 300);
  --chart-3: oklch(0.75 0.13 200);
  --chart-4: oklch(0.78 0.15 145);
  --chart-5: oklch(0.75 0.16 55);
  --radius: 10px;

  display: flex;
  min-height: 100vh;
  background: var(--bg);
  color: var(--text);
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Inter, sans-serif;
}

.ap-shell[data-theme="light"] {
  --bg: oklch(0.985 0.003 275);
  --bg-elevated: oklch(1 0 0);
  --bg-elevated-2: oklch(0.96 0.008 275);
  --border: oklch(0.91 0.008 275);
  --text: oklch(0.21 0.02 275);
  --text-muted: oklch(0.52 0.02 275);
  --accent: oklch(0.53 0.2 280);
  --accent-contrast: oklch(0.99 0.005 280);
  --status-enviado: oklch(0.52 0.02 275);
  --status-visto: oklch(0.35 0.12 285);
  --status-en-proceso: oklch(0.45 0.15 85);
  --status-finalista: oklch(0.42 0.12 150);
  --status-finalizado: oklch(0.4 0.1 180);
  --status-rechazado: oklch(0.5 0.18 25);
  --chart-1: oklch(0.53 0.2 280);
  --chart-2: oklch(0.66 0.16 300);
  --chart-3: oklch(0.72 0.13 200);
  --chart-4: oklch(0.75 0.15 145);
  --chart-5: oklch(0.7 0.16 55);
}

/* Fondos suaves para los badges de estado — versión clara y translúcida
   de cada color, independiente del tema (el color de arriba ya cambia solo). */
.ap-shell[data-theme="light"] .ap-badge {
  --badge-bg-opacity: 12%;
}

/* ── Sidebar ────────────────────────────────────────────── */

.ap-sidebar {
