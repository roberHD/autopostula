}

/* ── Contenido principal ────────────────────────────────── */

.ap-main {
  flex: 1;
  padding: 32px 40px;
  max-width: 1800px;
  width: 100%;
}

.ap-page-header {
  margin-bottom: 24px;
}

.ap-page-title {
  font-size: 22px;
  font-weight: 600;
  margin: 0 0 4px;
}

.ap-page-sub {
  font-size: 13px;
  color: var(--text-muted);
  margin: 0;
}

/* ── Toolbar (búsqueda + filtros) ───────────────────────── */

.ap-toolbar {
  display: flex;
  align-items: center;
  gap: 10px;
  margin-bottom: 18px;
  flex-wrap: wrap;
}

.ap-search {
  flex: 1;
  min-width: 200px;
  padding: 9px 12px;
  background: var(--bg-elevated);
  border: 1px solid var(--border);
  border-radius: 8px;
  color: var(--text);
  font-size: 13px;
}

