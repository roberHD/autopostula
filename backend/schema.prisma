generator client {
  provider = "prisma-client"
  output   = "./lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────
// Enums
// ─────────────────────────────────────────

enum Rol {
  USUARIO
  ADMIN
  STAFF
}

enum TipoPlan {
  FREE
  PREMIUM
}

enum NivelAnaliticas {
  BASICO
  AVANZADO
}

enum EstadoSuscripcion {
  ACTIVA
  CANCELADA
  VENCIDA
}

enum EstadoPago {
  // docs/pase-prepagado.md §4: el pago existe ANTES que el pase -- se crea al
  // iniciar el pago en Flow, cuando todavía no hay nada pagado.
  PENDIENTE
  PAGADO
  FALLIDO
  // Status 4 de Flow.
  ANULADO
  REEMBOLSADO
}

enum OrigenOferta {
  MANUAL
  AUTOMATICO
}

enum EstadoPostulacion {
  ENVIADO
  VISTO
  EN_PROCESO
  FINALISTA
  FINALIZADO
  RECHAZADO
  // No es un estado de avance como los de arriba — significa que el intento de
  // postulación automática no se pudo terminar (ej: el portal redirige a un sitio
  // externo de la empresa, o quedó una pregunta obligatoria sin responder). Queda
  // marcada para que la persona la termine a mano; ver Application.notaAtencion.
  INCOMPLETA
}

// Ver docs/rediseno-filtrado-ofertas.md §8: el triaje de onboarding y la banda
// gris son la misma interacción ("¿postularías a esto? Sí/No") y escriben en
// la misma tabla (DecisionOferta) para que recompilar el perfil sea trivial.
enum FuenteDecision {
  TRIAJE_ONBOARDING
  BANDA_GRIS
  HISTORIAL // pulgar abajo en /dashboard/historial
}

enum Veredicto {
  PENDIENTE
  SI
  NO
  EXPIRADA
}

enum TipoCalibracion {
  FRASE
  HISTORIA
  COMPARACION
  VOCABULARIO
  FORMALIDAD
  PRIORIDAD
  ESCRITURA
}

enum EstadoRefinamiento {
  PENDIENTE
  RESPONDIDA
}

// ─────────────────────────────────────────
// Cuentas y planes
// ─────────────────────────────────────────

model User {
  id              String   @id @default(uuid())
  email           String   @unique
  passwordHash    String?  @map("password_hash")
  oauthProvider   String?  @map("oauth_provider")
  nombre          String?
  rol             Rol      @default(USUARIO)
  apiToken        String?  @unique @map("api_token")
  usarFiltroIA    Boolean  @default(true) @map("usar_filtro_ia")
  // Preferencia propia del usuario, independiente de si el plan lo permite —
  // deja pausar/reanudar la búsqueda automática sin perder el beneficio del plan.
  busquedaAutomaticaActiva Boolean @default(true) @map("busqueda_automatica_activa")
  onboardingCompletado Boolean @default(false) @map("onboarding_completado")
  // El único paso del onboarding que la extensión confirma del lado del
  // navegador, no del servidor — sin esto, retomar el onboarding (recargar
  // la página, volver más tarde) no tenía forma de saber que ya se había
  // conectado y mandaba a la persona de vuelta a un paso anterior.
  extensionConectada Boolean @default(false) @map("extension_conectada")
  // Cuándo se conectó por primera vez (docs/rafagas-y-ponerse-al-dia.md §3.8): el
  // recordatorio por correo necesita saber hace cuánto está conectada para poder
  // decir "todavía no se puso al día" a quien nunca corrió una ráfaga. null en
  // las cuentas que ya estaban conectadas antes de que existiera esta columna, y
  // a esas no se les manda ese aviso (ver lib/recordatorio-rafaga.ts).
  extensionConectadaEn DateTime? @map("extension_conectada_en")
  // Distingue "la IA lo sacó del CV" de "la persona lo confirmó" (ver
  // docs/objetivo-laboral.md §5.2). Sin esto no hay forma de saber si el
  // ObjetivoLaboral de alguien es una sugerencia sin revisar o algo que de
  // verdad declaró -- ni de que compilar-perfil sepa cuál de las dos fuentes
  // usar. false para todo usuario existente: no rompe a quien ya está
  // dentro, sigue funcionando con CvProfile.cargoObjetivo como hasta ahora.
  objetivoConfirmado Boolean @default(false) @map("objetivo_confirmado")
  // Se guarda apenas se crea el cliente en Flow (pasarela de pago -- Stripe no
  // opera en Chile), para poder mandarlo a registrar su tarjeta y suscribirlo
  // sin tener que crear el cliente de nuevo cada vez.
  flowCustomerId String? @map("flow_customer_id")
  // ── recuperación de contraseña ──
  resetToken       String?   @unique @map("reset_token")
  resetTokenExpiry DateTime? @map("reset_token_expiry")
  // ── verificación de correo (docs/verificacion-de-correo.md) ──
  // Campos propios, no se reusan los de arriba: una persona puede tener los
  // dos flujos abiertos a la vez (pidió reset Y todavía no verifica) y se
  // pisarían. null = sin verificar; con fecha = cuándo (más útil que un
  // booleano para soporte y métricas de conversión del registro).
  emailVerificado   DateTime? @map("email_verificado")
  verifyToken       String?   @unique @map("verify_token")
  verifyTokenExpiry DateTime? @map("verify_token_expiry")
  // Último envío del correo de verificación, para el límite de reenvíos
  // (docs/verificacion-de-correo.md §6) -- sin esto, ese endpoint es un
  // vector para bombardear de correos una dirección ajena.
  verifyUltimoEnvio DateTime? @map("verify_ultimo_envio")
  // Red de seguridad para cuentas nuevas (docs/revision-2026-09-16.md §1.2):
  // false = la extensión trabaja en solo observar aunque el toggle del popup
  // diga otra cosa. Existe porque una cuenta nueva sin perfil postuló a
  // 55/55 ofertas reales en los 3 portales (comunas evitadas, turnos de
  // noche, todo) apenas se conectó la extensión. La persona lo activa desde
  // el panel una vez que ve qué habría postulado. Las cuentas existentes ya
  // están usando el producto: la migración las deja en true.
  postulacionHabilitada Boolean @default(false) @map("postulacion_habilitada")
  // Cuándo terminó la última ráfaga de la extensión (docs/rafagas-y-ponerse-al-dia.md
  // §3.4). Solo cuenta una que TERMINÓ: una interrumpida no "puso al día" a
  // nadie. null = todavía no hubo ninguna. Lo lee la tarjeta del panel y,
  // más adelante, el recordatorio por correo.
  ultimaRafagaEn DateTime? @map("ultima_rafaga_en")
  // Postulaciones automáticas de PRUEBA que le quedan a una cuenta gratis
  // (docs/rafagas-y-ponerse-al-dia.md §4.1): las primeras 5 que envía una
  // ráfaga, una sola vez por cuenta y no por mes. Solo se descuenta con una
  // postulación realmente enviada (no INCOMPLETA) desde una ráfaga; ver
  // lib/prueba-automatica.ts. Premium y admin ni la miran.
  pruebaAutomaticaRestantes Int @default(5) @map("prueba_automatica_restantes")
  // Recordatorio por correo cuando lleva días sin ponerse al día (docs/rafagas-y-ponerse-al-dia.md
  // §3.8). Cuándo salió el último (null = nunca); con recordatoriosActivos en
  // false -- el enlace de baja del propio correo, sin iniciar sesión -- no sale
  // ninguno más.
  recordatorioRafagaEn DateTime? @map("recordatorio_rafaga_en")
  recordatoriosActivos Boolean   @default(true) @map("recordatorios_activos")
  creadoEn        DateTime @default(now()) @map("creado_en")

  subscriptions     Subscription[]
  payments          Payment[]
  platformAccounts  PlatformAccount[]
  cvProfile         CvProfile?
  styleProfiles     StyleProfile[]
  applications      Application[]
  adminProfile      AdminProfile?
  aiUsageLogs       AiUsageLog[]
  searchPreferences SearchPreferences?
  decisionesOferta  DecisionOferta[]
  objetivosLaborales ObjetivoLaboral[]
  rafagas           Rafaga[]

  @@map("users")
}

// Lo que la persona declara que busca -- distinto de CvProfile.cargoObjetivo,
// que es lo que la IA infirió del CV. El CV dice de dónde viene, esto dice a
// dónde va (docs/objetivo-laboral.md §1). Puede haber varios a la vez (§5,
// §9: alguien cambiándose de rubro quiere postular a lo que puede conseguir
// mientras persigue lo que quiere).
model ObjetivoLaboral {
  id       String @id @default(uuid())
  userId   String @map("user_id")
  // Código CIUO cuando se eligió del catálogo (backend/scripts/data/catalogo-ocupaciones-cl.json);
  // null si se escribió libre -- ver docs/objetivo-laboral.md §4 sobre por qué
  // preferir el catálogo (ancla el triaje a un código, no a un string difuso).
  ciuo     String? @db.VarChar(4)
  // Nombre mostrable, siempre presente (del catálogo o tal cual se escribió).
  etiqueta String
  // 1.0 = objetivo principal. 0.3-0.6 = lo aceptaría pero no lo busca
  // activamente. Alimenta directo el peso de perfilCompilado.roles[].
  peso     Float    @default(1.0)
  orden    Int      @default(0)
  creadoEn DateTime @default(now()) @map("creado_en")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, orden])
  @@map("objetivos_laborales")
}

model Plan {
  id                       String           @id @default(uuid())
  tipo                     TipoPlan
  nombre                   String
  precioMensual            Float            @map("precio_mensual")
  maxPlataformasActivas    Int?             @map("max_plataformas_activas")
  limitePostulacionesMes   Int?             @map("limite_postulaciones_mes")
  busquedaAutomatica       Boolean          @default(false) @map("busqueda_automatica")
  muestraAnuncios          Boolean          @default(true) @map("muestra_anuncios")
  guardaConversacionesIa   Boolean          @default(false) @map("guarda_conversaciones_ia")
  perfilDinamico           Boolean          @default(false) @map("perfil_dinamico")
  limiteLlamadasIaMes      Int?             @map("limite_llamadas_ia_mes")
  nivelAnaliticas          NivelAnaliticas  @default(BASICO) @map("nivel_analiticas")

  subscriptions Subscription[]

  @@map("plans")
}

model Subscription {
  id                     String            @id @default(uuid())
  // Opcional a propósito. Al borrar una cuenta, la suscripción y sus pagos NO
  // se borran en cascada: quedan como registro contable sin dueño (SetNull).
  // La normativa tributaria exige conservarlos y la política de privacidad §7
  // lo promete. Sin userId ya no quedan ligados a ningún dato personal en
  // nuestra base.
  userId                 String?           @map("user_id")
  planId                 String            @map("plan_id")
  estado                 EstadoSuscripcion @default(ACTIVA)
  flowSubscriptionId     String?           @map("flow_subscription_id")
  periodoInicio          DateTime?         @map("periodo_inicio")
  periodoFin             DateTime?         @map("periodo_fin")
  // Idempotencia de los avisos de vencimiento (docs/pase-prepagado.md §6): cada
  // correo sale una sola vez por pase.
  avisoPrevioEn          DateTime?         @map("aviso_previo_en")
  avisoFinalEn           DateTime?         @map("aviso_final_en")

  user     User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  plan     Plan      @relation(fields: [planId], references: [id])
  payments Payment[]

  @@map("subscriptions")
}

// Un pago de un pase prepagado (docs/pase-prepagado.md §4). Se crea PENDIENTE al
// iniciar el pago y, cuando Flow confirma, se enlaza al pase (Subscription) que
// se acredita.
model Payment {
  id              String     @id @default(uuid())
  // Opcional: un pago PENDIENTE todavía no tiene pase. Se enlaza al acreditarse.
  // SetNull (antes Cascade): un pase que se borra no puede arrastrar el registro
  // del pago, que se conserva por normativa tributaria.
  subscriptionId  String?    @map("subscription_id")
  // Directo al usuario porque el pago existe antes que el pase. SetNull por la
  // misma razón que Subscription: los registros de pago sobreviven al borrado de
  // la cuenta (política de privacidad §7).
  userId          String?    @map("user_id")
  // Lo generamos nosotros y se lo pasamos a Flow. Es lo que identifica el pago
  // cuando Flow avisa -- nunca el email del pagador, que puede ser distinto del
  // de la cuenta.
  commerceOrder   String     @unique @map("commerce_order")
  pase            String     // "pase_30" | "pase_90" (lib/pases.ts)
  dias            Int
  flowOrder       String?    @map("flow_order")
  monto           Float
  estado          EstadoPago @default(PENDIENTE)
  fecha           DateTime   @default(now())

  subscription Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  user         User?         @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@map("payments")
}

// ─────────────────────────────────────────
// Portales y conexiones
// ─────────────────────────────────────────

model JobPlatform {
  id              String @id @default(uuid())
  nombre          String @unique
  urlBase         String @map("url_base")
  adapterVersion  String @map("adapter_version")

  platformAccounts PlatformAccount[]
  jobOffers        JobOffer[]
  titulosCanonicos TituloCanonico[]

  @@map("job_platforms")
}

// El corpus compilado de títulos de cargo (ver docs/rediseno-filtrado-ofertas.md, §7 y
// §9.1). GLOBAL, no por usuario -- un título canónico vale para todos, así que el
// usuario N+1 es casi gratis. Se llena por cosecha pasiva desde la extensión (§7.2):
// cada escaneo reporta los títulos que vio, pasaran el filtro o no. formaLimpia y
// rolCanonico arrancan iguales a formaCruda -- el parser determinista (§7.3) y la
// agrupación con IA (§7.4) los van refinando después, en batch, no en cada escritura.
model TituloCanonico {
  id            String       @id @default(uuid())
  formaCruda    String       @unique @map("forma_cruda")
  formaLimpia   String       @map("forma_limpia")
  rolCanonico   String?      @map("rol_canonico")
  // ── La llave del sistema ──
  // Código CIUO-08.CL de 4 dígitos. Es lo que une catálogo y cosecha: las filas
  // del catálogo nacen con él poblado (§7.1) y las cosechadas lo reciben al ser
  // clasificadas (§7.4). Todo el matching por rol se hace contra este campo, no
  // contra strings. Ver docs/rediseno-filtrado-ofertas.md §7.1/§9.1.
  ciuo          String?      @db.VarChar(4)
  // De dónde salió esta fila. Las del catálogo oficial nacen con ciuo ya
  // poblado y son la capa canónica; las cosechadas nacen sin él y se
  // clasifican contra las primeras (§7.4).
  origen        OrigenTitulo @default(COSECHADO)
  codigoOficial String?      @map("codigo_oficial") // código de perfil ChileValora, si aplica
  frecuencia    Int          @default(1) // solo significativa en COSECHADO
  platformId    String?      @map("platform_id")
  actualizadoEn DateTime     @updatedAt @map("actualizado_en")

  platform JobPlatform? @relation(fields: [platformId], references: [id])

  @@index([ciuo])
  @@index([frecuencia])
  @@index([origen, ciuo]) // para "títulos sin clasificar" del job de §7.4
  @@map("titulos_canonicos")
}

// Los 444 grupos primarios del CIUO-08.CL, con su jerarquía. Tabla chica y fija.
// Sirve para nombrar roles de forma legible y para calcular vecindad entre
// roles en el triaje (§8.3) -- dos códigos del mismo subgrupo son vecinos por
// construcción, sin IA ni embeddings.
model GrupoCiuo {
  codigo    String @id @db.VarChar(4) // "5223"
  nombre    String // "Vendedores y asistentes de venta de tiendas..."
  subgrupo  String @db.VarChar(3) // "522" -- derivado, para vecindad
  granGrupo String @map("gran_grupo") @db.VarChar(1) // "5" -- derivado

  @@index([subgrupo])
  @@map("grupos_ciuo")
}

enum OrigenTitulo {
  CATALOGO_OFICIAL // CIUO-08.CL o ChileValora -- la capa canónica (§7.1)
  COSECHADO // visto por la extensión en un portal real (§7.2)
}

model PlatformAccount {
  id                    String   @id @default(uuid())
  userId                String   @map("user_id")
  platformId            String   @map("platform_id")
  activa                Boolean  @default(true)
  conectadaEn           DateTime @default(now()) @map("conectada_en")

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  platform     JobPlatform   @relation(fields: [platformId], references: [id])
  applications Application[]

  @@unique([userId, platformId])
  @@map("platform_accounts")
}

// ─────────────────────────────────────────
// Perfiles del usuario
// ─────────────────────────────────────────

model CvProfile {
  id             String   @id @default(uuid())
  userId         String   @unique @map("user_id")
  nombreArchivo  String?  @map("nombre_archivo")
  textoExtraido  String?  @db.Text @map("texto_extraido")
  subidoEn       DateTime @default(now()) @map("subido_en")

  // ── Datos del perfil del candidato ──
  nombre              String?
  email               String?
  telefono            String?
  comuna              String?
  rut                 String?
  cargoObjetivo       String?  @map("cargo_objetivo")
  expectativaRenta    String?  @map("expectativa_renta")
  disponibilidad      String?
  modalidad           String?
  resumenProfesional  String?  @db.Text @map("resumen_profesional")
  experiencia         Json?
  habilidades         Json?

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  applications Application[]

  @@map("cv_profiles")
}

model StyleProfile {
  id                   String   @id @default(uuid())
  userId               String   @map("user_id")
  nombrePerfil         String?  @map("nombre_perfil")
  tono                 String?
  objetivo             String?
  conversacion         Json?
  confianzaPorcentaje  Int      @default(0) @map("confianza_porcentaje")
  fuentesCompletadas   Json?    @map("fuentes_completadas")
  longitudRespuesta    String   @default("media") @map("longitud_respuesta")
  instrucciones        String?  @db.Text
  usarPerfil           Boolean  @default(true) @map("usar_perfil")
  evitarRepetidas      Boolean  @default(true) @map("evitar_repetidas")
  resumen              String?  @db.Text
  fortalezas           Json?
  motivaciones         String?  @db.Text
  estiloDetalle        Json?    @map("estilo_detalle")
  manualEscritura      Json?    @map("manual_escritura")
  confirmado           Boolean  @default(false)
  creadoEn             DateTime @default(now()) @map("creado_en")

  user               User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  applications       Application[]
  calibrationAnswers StyleCalibrationAnswer[]
  refinements        StyleRefinement[]

  @@map("style_profiles")
}

model SearchPreferences {
  id              String   @id @default(uuid())
  userId          String   @unique @map("user_id")
  palabrasIncluir Json?    @map("palabras_incluir")
  palabrasExcluir Json?    @map("palabras_excluir")
  modalidad       String   @default("cualquiera")
  jornada         String   @default("cualquiera")
  // El Perfil de Búsqueda compilado (docs/rediseno-filtrado-ofertas.md §5) --
  // reemplaza las columnas de arriba, que se conservan durante la transición
  // para poder hacer rollback sin migración inversa. version se incrementa en
  // cada recompilación e invalida el caché de veredictos del scorer (§6).
  perfilCompilado Json?    @map("perfil_compilado")
  versionPerfil   Int      @default(0) @map("version_perfil")
  // Flag de transición (§13: "no borrar coincideFiltros hasta que el scorer
  // esté validado -- dejar las dos rutas conviviendo detrás de un flag").
  // docs/revision-2026-09-16.md §1.4: pasa a default(true) -- el motor nuevo
  // ya no es opcional, es lo único que decide 'postular' (§1.1 ya sacó al
  // filtro viejo de esa decisión). El campo se conserva por si hiciera falta
  // apagarlo para una cuenta puntual, no como flag de adopción gradual.
  usarScorerLocal Boolean  @default(true) @map("usar_scorer_local")
  // true si un cambio de objetivo laboral disparó una recompilación forzada
  // (docs/objetivo-laboral.md §6) que falló -- perfilCompilado sigue
  // reflejando el objetivo VIEJO mientras esto esté prendido. Sin esta
  // bandera, el scorer seguiría puntuando en silencio con el rubro
  // equivocado hasta la próxima recompilación exitosa (reabre P2 por la
  // vía de excepción). Se limpia sola en la próxima compilación exitosa.
  perfilDesactualizado Boolean @default(false) @map("perfil_desactualizado")
  // docs/revision-2026-09-16.md §2.1: la ubicación se DECLARA, no se infiere.
  // Antes compilar-perfil.ts le pasaba a la IA la comuna del CV y le pedía
  // adivinar ubicacion.comunas -- en la cuenta de prueba, la persona pidió
  // "Maipú, Cerrillos o Estación Central" y el perfil compilado terminó con
  // ["maipu","pudahuel","santiago"] (agregó la comuna de su trabajo ANTERIOR,
  // que quería evitar, omitió dos de las que pidió, y sumó "santiago" porque
  // eso decía su CV). Forma: { regiones: string[] (códigos), comunas:
  // string[], todaLaRegion: boolean, aceptaRemoto: boolean }. Opciones
  // cerradas (ver /api/regiones-comunas) -- nunca texto libre.
  ubicacionDeclarada Json? @map("ubicacion_declarada")
  actualizadoEn   DateTime @updatedAt @map("actualizado_en")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("search_preferences")
}

model AdminProfile {
  id           String @id @default(uuid())
  userId       String @unique @map("user_id")
  nivelAcceso  String @map("nivel_acceso")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("admin_profiles")
}

// ─────────────────────────────────────────
// Postulaciones
// ─────────────────────────────────────────

// §9.3 del rediseño: deja de ser "solo lo postulado" y pasa a ser el corpus
// de avistamientos -- la extensión reporta CADA tarjeta que ve (se postule,
// quede en gris o se descarte), no solo las que terminan en Application.
// Global (dedup por platformId+externalId): la misma oferta vista por
// distintos usuarios es una sola fila, no se duplica por usuario.
model JobOffer {
  id            String        @id @default(uuid())
  platformId    String        @map("platform_id")
  externalId    String        @map("external_id")
  titulo        String
  empresa       String?
  url           String?
  origen        OrigenOferta  @default(MANUAL)
  // true = alguien se postuló de verdad (tiene Application). false = solo
  // avistamiento -- la extensión la vio pero nunca se postuló. Default true
  // porque las filas que ya existían en la base, antes de este campo, SON
  // postulaciones reales; la migración no debe reescribir su significado.
  postulada     Boolean       @default(true)
  relevanciaAi  Float?        @map("relevancia_ai")
  publicadaEn   DateTime?     @map("publicada_en")
  cacheadaEn    DateTime      @default(now()) @map("cacheada_en")

  platform     JobPlatform      @relation(fields: [platformId], references: [id])
  applications Application[]
  decisiones   DecisionOferta[]

  @@unique([platformId, externalId])
  // Para el purgado de avistamientos viejos sin postulación (scripts/purgar-avistamientos.ts).
  @@index([postulada, cacheadaEn])
  @@map("job_offers")
}

// Etiquetas del usuario sobre ofertas -- UNA sola tabla para triaje de
// onboarding, banda gris y pulgar-abajo del historial (§8.1). Es lo que
// permite que recompilar el Perfil de Búsqueda sea una query trivial:
// prisma.decisionOferta.findMany({ where: { userId, veredicto: { in: ["SI","NO"] } } })
model DecisionOferta {
  id          String         @id @default(uuid())
  userId      String         @map("user_id")
  jobOfferId  String?        @map("job_offer_id") // null si viene del triaje de onboarding
  tituloCrudo String         @map("titulo_crudo")
  // Solo se llenan para BANDA_GRIS -- JobOffer todavía nace solo al postular
  // (§9.3 plantea que pase a ser el corpus de avistamientos, pero eso es un
  // cambio más grande que se deja para después). Mientras tanto, la URL vive
  // acá directo: es lo mínimo que necesita la aprobación para volver a la
  // extensión (§8.6).
  url         String?
  empresa     String?
  plataforma  String?
  scoreLocal  Int?           @map("score_local") // el puntaje que la dejó en gris (§6)
  razones     Json? // por qué cayó ahí -- para mostrárselo al usuario
  // Facetas leídas al abrir el aviso en la Etapa 2 (docs/visibilidad-y-etapa2.md
  // §B/§E): { jornada, modalidad, contrato, sueldo, publicadaHace,
  // ratingEmpresa, evaluaciones, extracto } -- todos opcionales, la tarjeta
  // degrada sola si falta (escaneo cortado, portal cambió, fila vieja).
  // Json y no columnas porque cada portal expone facetas distintas y esto
  // solo se lee para pintar la tarjeta, nunca para filtrar ni agrupar.
  detalleAviso Json?         @map("detalle_aviso")
  fuente      FuenteDecision
  veredicto   Veredicto      @default(PENDIENTE)
  venceEn     DateTime?      @map("vence_en")
  decididoEn  DateTime?      @map("decidido_en")
  creadoEn    DateTime       @default(now()) @map("creado_en")

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobOffer JobOffer? @relation(fields: [jobOfferId], references: [id])

  @@index([userId, veredicto, venceEn])
  @@map("decisiones_oferta")
}

model Application {
  id                  String            @id @default(uuid())
  userId              String            @map("user_id")
  jobOfferId          String            @map("job_offer_id")
  platformAccountId   String            @map("platform_account_id")
  cvProfileId         String            @map("cv_profile_id")
  styleProfileId      String?           @map("style_profile_id")
  estadoActual        EstadoPostulacion @default(ENVIADO) @map("estado_actual")
  // Solo se usa cuando estadoActual = INCOMPLETA — explica por qué no se pudo
  // terminar sola (ej: "Redirige al portal externo de la empresa para continuar").
  notaAtencion        String?           @map("nota_atencion")
  enviadaEn           DateTime          @default(now()) @map("enviada_en")
  // true = una de las 5 postulaciones de la prueba automática (§4.1 de
  // docs/rafagas-y-ponerse-al-dia.md). Es lo que deja que "Ver las 5" filtre
  // el historial: la prueba se demuestra con resultados concretos, no con un
  // mensaje. Máximo 5 filas por cuenta.
  esDePrueba          Boolean           @default(false) @map("es_de_prueba")

  user             User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobOffer         JobOffer                   @relation(fields: [jobOfferId], references: [id])
  platformAccount  PlatformAccount            @relation(fields: [platformAccountId], references: [id], onDelete: Cascade)
  cvProfile        CvProfile                  @relation(fields: [cvProfileId], references: [id], onDelete: Cascade)
  styleProfile     StyleProfile?              @relation(fields: [styleProfileId], references: [id], onDelete: Cascade)
  statusHistory    ApplicationStatusHistory[]
  answers          ApplicationAnswer[]

  @@map("applications")
}

model ApplicationStatusHistory {
  id             String            @id @default(uuid())
  applicationId  String            @map("application_id")
  estado         EstadoPostulacion
  cambiadoEn     DateTime          @default(now()) @map("cambiado_en")

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@map("application_status_history")
}

model AiUsageLog {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  tipo      String
  creadoEn  DateTime @default(now()) @map("creado_en")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("ai_usage_logs")
}

// Una "ráfaga" es una pasada de la extensión para ponerse al día -- abrir las
// búsquedas de cada portal, escanear, postular -- disparada al abrir Chrome,
// al despertar el equipo, por el chequeo periódico o a pedido (docs/rafagas-y-ponerse-al-dia.md
// §3.4). Sirve para decirle a la persona qué pasó mientras no miraba (ícono,
// popup, tarjeta del panel) y para saber cuánto suele demorar una.
//
// El estado real vive en la extensión (chrome.storage); esto es solo el
// registro. La extensión reporta al empezar y al terminar, por eso el mismo
// registro se actualiza: extensionId es el id que le puso la extensión, y
// (userId, extensionId) es único para que un reintento de red no duplique la
// fila -- ni una persona pueda pisar la de otra mandando su mismo id.
//
// Son datos de uso, no del contenido de nada: se purgan a los 90 días junto
// con los avistamientos (lib/purgar-avistamientos.ts).
model Rafaga {
  id          String    @id @default(uuid())
  userId      String    @map("user_id")
  extensionId String    @map("extension_id")
  disparador  String // inicio_chrome | despertar | chequeo | manual | activacion
  inicio      DateTime
  fin         DateTime?
  estado      String // en_curso | terminada | interrumpida
  postuladas  Int       @default(0)
  // En modo "solo observar" no se postula: son las que HABRÍA postulado. Sin
  // esta columna, una cuenta nueva (que arranca observando, ver
  // User.postulacionHabilitada) vería siempre "0" en su tarjeta del panel.
  observadas  Int       @default(0)
  descartadas Int       @default(0)
  gris        Int       @default(0)
  errores     Int       @default(0)
  duracionMs  Int?      @map("duracion_ms")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, extensionId])
  @@index([userId, inicio])
  @@map("rafagas")
}

// ─────────────────────────────────────────
// Perfil dinámico (premium)
// ─────────────────────────────────────────

model StyleCalibrationAnswer {
  id               String          @id @default(uuid())
  styleProfileId   String          @map("style_profile_id")
  tipo             TipoCalibracion
  pregunta         String          @db.Text
  opcionElegida    String          @db.Text @map("opcion_elegida")
  respondidoEn     DateTime        @default(now()) @map("respondido_en")

  styleProfile StyleProfile @relation(fields: [styleProfileId], references: [id], onDelete: Cascade)

  @@map("style_calibration_answers")
}

model ApplicationAnswer {
  id             String   @id @default(uuid())
  applicationId  String   @map("application_id")
  pregunta       String   @db.Text
  respuestaIa    String   @db.Text @map("respuesta_ia")
  respuestaFinal String   @db.Text @map("respuesta_final")
  fueEditada     Boolean  @default(false) @map("fue_editada")
  tema           String?
  respondidoEn   DateTime @default(now()) @map("respondido_en")

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@map("application_answers")
}

model StyleRefinement {
  id                String             @id @default(uuid())
  styleProfileId    String             @map("style_profile_id")
  patronDetectado   String             @db.Text @map("patron_detectado")
  preguntaGenerada  String             @db.Text @map("pregunta_generada")
  opcionesJson      Json               @map("opciones_json")
  respuestaElegida  String?            @db.Text @map("respuesta_elegida")
  estado            EstadoRefinamiento @default(PENDIENTE)
  creadoEn          DateTime           @default(now()) @map("creado_en")

  styleProfile StyleProfile @relation(fields: [styleProfileId], references: [id], onDelete: Cascade)

  @@map("style_refinements")
}
