generator client {
  provider = "prisma-client"
  output   = "./lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────
// Enums
// ─────────────────────────────────────────

enum Rol {
  USUARIO
  ADMIN
  STAFF
}

enum TipoPlan {
  FREE
  PREMIUM
}

enum NivelAnaliticas {
  BASICO
  AVANZADO
}

enum EstadoSuscripcion {
  ACTIVA
  CANCELADA
  VENCIDA
}

enum EstadoPago {
  PAGADO
  FALLIDO
  REEMBOLSADO
}

enum OrigenOferta {
  MANUAL
  AUTOMATICO
}

enum EstadoPostulacion {
  ENVIADO
  VISTO
  EN_PROCESO
  FINALISTA
  FINALIZADO
  RECHAZADO
  // No es un estado de avance como los de arriba — significa que el intento de
  // postulación automática no se pudo terminar (ej: el portal redirige a un sitio
  // externo de la empresa, o quedó una pregunta obligatoria sin responder). Queda
  // marcada para que la persona la termine a mano; ver Application.notaAtencion.
  INCOMPLETA
}

enum TipoCalibracion {
  FRASE
  HISTORIA
  COMPARACION
  VOCABULARIO
  FORMALIDAD
  PRIORIDAD
  ESCRITURA
}

enum EstadoRefinamiento {
  PENDIENTE
  RESPONDIDA
}

// ─────────────────────────────────────────
// Cuentas y planes
// ─────────────────────────────────────────

model User {
  id              String   @id @default(uuid())
  email           String   @unique
  passwordHash    String?  @map("password_hash")
  oauthProvider   String?  @map("oauth_provider")
  nombre          String?
  rol             Rol      @default(USUARIO)
  apiToken        String?  @unique @map("api_token")
  usarFiltroIA    Boolean  @default(true) @map("usar_filtro_ia")
  // Preferencia propia del usuario, independiente de si el plan lo permite —
  // deja pausar/reanudar la búsqueda automática sin perder el beneficio del plan.
  busquedaAutomaticaActiva Boolean @default(true) @map("busqueda_automatica_activa")
  onboardingCompletado Boolean @default(false) @map("onboarding_completado")
  // El único paso del onboarding que la extensión confirma del lado del
  // navegador, no del servidor — sin esto, retomar el onboarding (recargar
  // la página, volver más tarde) no tenía forma de saber que ya se había
  // conectado y mandaba a la persona de vuelta a un paso anterior.
  extensionConectada Boolean @default(false) @map("extension_conectada")
  // Se guarda apenas se crea el cliente en Flow (pasarela de pago -- Stripe no
  // opera en Chile), para poder mandarlo a registrar su tarjeta y suscribirlo
  // sin tener que crear el cliente de nuevo cada vez.
  flowCustomerId String? @map("flow_customer_id")
  // ── recuperación de contraseña ──
  resetToken       String?   @unique @map("reset_token")
  resetTokenExpiry DateTime? @map("reset_token_expiry")
  creadoEn        DateTime @default(now()) @map("creado_en")

  subscriptions     Subscription[]
  platformAccounts  PlatformAccount[]
  cvProfile         CvProfile?
  styleProfiles     StyleProfile[]
  applications      Application[]
  adminProfile      AdminProfile?
  aiUsageLogs       AiUsageLog[]
  searchPreferences SearchPreferences?

  @@map("users")
}

model Plan {
  id                       String           @id @default(uuid())
  tipo                     TipoPlan
  nombre                   String
  precioMensual            Float            @map("precio_mensual")
  maxPlataformasActivas    Int?             @map("max_plataformas_activas")
  limitePostulacionesMes   Int?             @map("limite_postulaciones_mes")
  busquedaAutomatica       Boolean          @default(false) @map("busqueda_automatica")
  muestraAnuncios          Boolean          @default(true) @map("muestra_anuncios")
  guardaConversacionesIa   Boolean          @default(false) @map("guarda_conversaciones_ia")
  perfilDinamico           Boolean          @default(false) @map("perfil_dinamico")
  limiteLlamadasIaMes      Int?             @map("limite_llamadas_ia_mes")
  nivelAnaliticas          NivelAnaliticas  @default(BASICO) @map("nivel_analiticas")

  subscriptions Subscription[]

  @@map("plans")
}

model Subscription {
  id                     String            @id @default(uuid())
  userId                 String            @map("user_id")
  planId                 String            @map("plan_id")
  estado                 EstadoSuscripcion @default(ACTIVA)
  flowSubscriptionId     String?           @map("flow_subscription_id")
  periodoInicio          DateTime?         @map("periodo_inicio")
  periodoFin             DateTime?         @map("periodo_fin")

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan     Plan      @relation(fields: [planId], references: [id])
  payments Payment[]

  @@map("subscriptions")
}

model Payment {
  id              String     @id @default(uuid())
  subscriptionId  String     @map("subscription_id")
  flowOrder       String?    @map("flow_order")
  monto           Float
  estado          EstadoPago @default(PAGADO)
  fecha           DateTime   @default(now())

  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@map("payments")
}

// ─────────────────────────────────────────
// Portales y conexiones
// ─────────────────────────────────────────

model JobPlatform {
  id              String @id @default(uuid())
  nombre          String @unique
  urlBase         String @map("url_base")
  adapterVersion  String @map("adapter_version")

  platformAccounts PlatformAccount[]
  jobOffers        JobOffer[]
  titulosCanonicos TituloCanonico[]

  @@map("job_platforms")
}

// El corpus compilado de títulos de cargo (ver docs/rediseno-filtrado-ofertas.md, §7 y
// §9.1). GLOBAL, no por usuario -- un título canónico vale para todos, así que el
// usuario N+1 es casi gratis. Se llena por cosecha pasiva desde la extensión (§7.2):
// cada escaneo reporta los títulos que vio, pasaran el filtro o no. formaLimpia y
// rolCanonico arrancan iguales a formaCruda -- el parser determinista (§7.3) y la
// agrupación con IA (§7.4) los van refinando después, en batch, no en cada escritura.
model TituloCanonico {
  id            String       @id @default(uuid())
  formaCruda    String       @unique @map("forma_cruda")
  formaLimpia   String       @map("forma_limpia")
  rolCanonico   String?      @map("rol_canonico")
  // ── La llave del sistema ──
  // Código CIUO-08.CL de 4 dígitos. Es lo que une catálogo y cosecha: las filas
  // del catálogo nacen con él poblado (§7.1) y las cosechadas lo reciben al ser
  // clasificadas (§7.4). Todo el matching por rol se hace contra este campo, no
  // contra strings. Ver docs/rediseno-filtrado-ofertas.md §7.1/§9.1.
  ciuo          String?      @db.VarChar(4)
  // De dónde salió esta fila. Las del catálogo oficial nacen con ciuo ya
  // poblado y son la capa canónica; las cosechadas nacen sin él y se
  // clasifican contra las primeras (§7.4).
  origen        OrigenTitulo @default(COSECHADO)
  codigoOficial String?      @map("codigo_oficial") // código de perfil ChileValora, si aplica
  frecuencia    Int          @default(1) // solo significativa en COSECHADO
  platformId    String?      @map("platform_id")
  actualizadoEn DateTime     @updatedAt @map("actualizado_en")

  platform JobPlatform? @relation(fields: [platformId], references: [id])

  @@index([ciuo])
  @@index([frecuencia])
  @@index([origen, ciuo]) // para "títulos sin clasificar" del job de §7.4
  @@map("titulos_canonicos")
}

// Los 430 grupos primarios del CIUO-08.CL, con su jerarquía. Tabla chica y fija.
// Sirve para nombrar roles de forma legible y para calcular vecindad entre
// roles en el triaje (§8.3) -- dos códigos del mismo subgrupo son vecinos por
// construcción, sin IA ni embeddings.
model GrupoCiuo {
  codigo    String @id @db.VarChar(4) // "5223"
  nombre    String // "Vendedores y asistentes de venta de tiendas..."
  subgrupo  String @db.VarChar(3) // "522" -- derivado, para vecindad
  granGrupo String @map("gran_grupo") @db.VarChar(1) // "5" -- derivado

  @@index([subgrupo])
  @@map("grupos_ciuo")
}

enum OrigenTitulo {
  CATALOGO_OFICIAL // CIUO-08.CL o ChileValora -- la capa canónica (§7.1)
  COSECHADO // visto por la extensión en un portal real (§7.2)
}

model PlatformAccount {
  id                    String   @id @default(uuid())
  userId                String   @map("user_id")
  platformId            String   @map("platform_id")
  activa                Boolean  @default(true)
  conectadaEn           DateTime @default(now()) @map("conectada_en")

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  platform     JobPlatform   @relation(fields: [platformId], references: [id])
  applications Application[]

  @@unique([userId, platformId])
  @@map("platform_accounts")
}

// ─────────────────────────────────────────
// Perfiles del usuario
// ─────────────────────────────────────────

model CvProfile {
  id             String   @id @default(uuid())
  userId         String   @unique @map("user_id")
  nombreArchivo  String?  @map("nombre_archivo")
  textoExtraido  String?  @db.Text @map("texto_extraido")
  subidoEn       DateTime @default(now()) @map("subido_en")

  // ── Datos del perfil del candidato ──
  nombre              String?
  email               String?
  telefono            String?
  comuna              String?
  rut                 String?
  cargoObjetivo       String?  @map("cargo_objetivo")
  expectativaRenta    String?  @map("expectativa_renta")
  disponibilidad      String?
  modalidad           String?
  resumenProfesional  String?  @db.Text @map("resumen_profesional")
  experiencia         Json?
  habilidades         Json?

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  applications Application[]

  @@map("cv_profiles")
}

model StyleProfile {
  id                   String   @id @default(uuid())
  userId               String   @map("user_id")
  nombrePerfil         String?  @map("nombre_perfil")
  tono                 String?
  objetivo             String?
  conversacion         Json?
  confianzaPorcentaje  Int      @default(0) @map("confianza_porcentaje")
  fuentesCompletadas   Json?    @map("fuentes_completadas")
  longitudRespuesta    String   @default("media") @map("longitud_respuesta")
  instrucciones        String?  @db.Text
  usarPerfil           Boolean  @default(true) @map("usar_perfil")
  evitarRepetidas      Boolean  @default(true) @map("evitar_repetidas")
  resumen              String?  @db.Text
  fortalezas           Json?
  motivaciones         String?  @db.Text
  estiloDetalle        Json?    @map("estilo_detalle")
  manualEscritura      Json?    @map("manual_escritura")
  confirmado           Boolean  @default(false)
  creadoEn             DateTime @default(now()) @map("creado_en")

  user               User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  applications       Application[]
  calibrationAnswers StyleCalibrationAnswer[]
  refinements        StyleRefinement[]

  @@map("style_profiles")
}

model SearchPreferences {
  id               String   @id @default(uuid())
  userId           String   @unique @map("user_id")
  palabrasIncluir  Json?    @map("palabras_incluir")
  palabrasExcluir  Json?    @map("palabras_excluir")
  modalidad        String   @default("cualquiera")
  jornada          String   @default("cualquiera")
  actualizadoEn    DateTime @updatedAt @map("actualizado_en")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("search_preferences")
}

model AdminProfile {
  id           String @id @default(uuid())
  userId       String @unique @map("user_id")
  nivelAcceso  String @map("nivel_acceso")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("admin_profiles")
}

// ─────────────────────────────────────────
// Postulaciones
// ─────────────────────────────────────────

model JobOffer {
  id            String        @id @default(uuid())
  platformId    String        @map("platform_id")
  externalId    String        @map("external_id")
  titulo        String
  empresa       String?
  url           String?
  origen        OrigenOferta  @default(MANUAL)
  relevanciaAi  Float?        @map("relevancia_ai")
  publicadaEn   DateTime?     @map("publicada_en")
  cacheadaEn    DateTime      @default(now()) @map("cacheada_en")

  platform     JobPlatform   @relation(fields: [platformId], references: [id])
  applications Application[]

  @@unique([platformId, externalId])
  @@map("job_offers")
}

model Application {
  id                  String            @id @default(uuid())
  userId              String            @map("user_id")
  jobOfferId          String            @map("job_offer_id")
  platformAccountId   String            @map("platform_account_id")
  cvProfileId         String            @map("cv_profile_id")
  styleProfileId      String?           @map("style_profile_id")
  estadoActual        EstadoPostulacion @default(ENVIADO) @map("estado_actual")
  // Solo se usa cuando estadoActual = INCOMPLETA — explica por qué no se pudo
  // terminar sola (ej: "Redirige al portal externo de la empresa para continuar").
  notaAtencion        String?           @map("nota_atencion")
  enviadaEn           DateTime          @default(now()) @map("enviada_en")

  user             User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobOffer         JobOffer                   @relation(fields: [jobOfferId], references: [id])
  platformAccount  PlatformAccount            @relation(fields: [platformAccountId], references: [id], onDelete: Cascade)
  cvProfile        CvProfile                  @relation(fields: [cvProfileId], references: [id], onDelete: Cascade)
  styleProfile     StyleProfile?              @relation(fields: [styleProfileId], references: [id], onDelete: Cascade)
  statusHistory    ApplicationStatusHistory[]
  answers          ApplicationAnswer[]

  @@map("applications")
}

model ApplicationStatusHistory {
  id             String            @id @default(uuid())
  applicationId  String            @map("application_id")
  estado         EstadoPostulacion
  cambiadoEn     DateTime          @default(now()) @map("cambiado_en")

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@map("application_status_history")
}

model AiUsageLog {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  tipo      String
  creadoEn  DateTime @default(now()) @map("creado_en")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("ai_usage_logs")
}

// ─────────────────────────────────────────
// Perfil dinámico (premium)
// ─────────────────────────────────────────

model StyleCalibrationAnswer {
  id               String          @id @default(uuid())
  styleProfileId   String          @map("style_profile_id")
  tipo             TipoCalibracion
  pregunta         String          @db.Text
  opcionElegida    String          @db.Text @map("opcion_elegida")
  respondidoEn     DateTime        @default(now()) @map("respondido_en")

  styleProfile StyleProfile @relation(fields: [styleProfileId], references: [id], onDelete: Cascade)

  @@map("style_calibration_answers")
}

model ApplicationAnswer {
  id             String   @id @default(uuid())
  applicationId  String   @map("application_id")
  pregunta       String   @db.Text
  respuestaIa    String   @db.Text @map("respuesta_ia")
  respuestaFinal String   @db.Text @map("respuesta_final")
  fueEditada     Boolean  @default(false) @map("fue_editada")
  tema           String?
  respondidoEn   DateTime @default(now()) @map("respondido_en")

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@map("application_answers")
}

model StyleRefinement {
  id                String             @id @default(uuid())
  styleProfileId    String             @map("style_profile_id")
  patronDetectado   String             @db.Text @map("patron_detectado")
  preguntaGenerada  String             @db.Text @map("pregunta_generada")
  opcionesJson      Json               @map("opciones_json")
  respuestaElegida  String?            @db.Text @map("respuesta_elegida")
  estado            EstadoRefinamiento @default(PENDIENTE)
  creadoEn          DateTime           @default(now()) @map("creado_en")

  styleProfile StyleProfile @relation(fields: [styleProfileId], references: [id], onDelete: Cascade)

  @@map("style_refinements")
}
