{
  "manifest_version": 3,
  "name": "AutoPostula",
  "version": "2.6.1",
  "description": "Postulaci\u00f3n autom\u00e1tica inteligente para Computrabajo y Laborum. Powered by IA.",
  "permissions": [
    "storage",
    "tabs",
    "alarms"
  ],
  "host_permissions": [
    "https://www.computrabajo.cl/*",
    "https://cl.computrabajo.com/*",
    "https://computrabajo.cl/*",
    "https://computrabajo.com/*",
    "https://www.laborum.cl/*",
    "http://localhost:3000/*",
    "https://autopostula.vercel.app/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.computrabajo.cl/*",
        "https://cl.computrabajo.com/*",
        "https://computrabajo.cl/*",
        "https://computrabajo.com/*"
      ],
      "js": [
        "core.js",
        "adapters/computrabajo.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.laborum.cl/*"
      ],
      "js": [
        "core.js",
        "adapters/laborum.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "http://localhost:3000/*",
        "https://autopostula.vercel.app/*"
      ],
      "js": [
        "bridge.js"
      ],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  }
}
